{
  "name": "softplay",
  "displayName": "SoftPlay",
  "description": "Drive Playwright's own real codegen tool from a VS Code sidebar, link a Cucumber Gherkin scenario to what it records, and get an AI-refined, enterprise-grade Java or Python test — with proper waits, logging, and BDD step definitions — via GitHub Copilot.",
  "version": "0.1.78",
  "publisher": "tdsecurities-quality-engineering",
  "private": true,
  "icon": "media/icon.png",
  "author": "WenYi Tan, Alicia Loh, Roshan Ranasinghe, Gaurav Misra",
  "contributors": [
    {
      "name": "WenYi Tan"
    },
    {
      "name": "Alicia Loh"
    },
    {
      "name": "Roshan Ranasinghe"
    },
    {
      "name": "Gaurav Misra"
    }
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "objectSpy",
          "title": "SoftPlay",
          "icon": "media/activitybar-icon.svg"
        }
      ]
    },
    "views": {
      "objectSpy": [
        {
          "type": "webview",
          "id": "objectSpy.mainView",
          "name": "Control Panel"
        }
      ]
    },
    "commands": [
      {
        "command": "objectSpy.openPanel",
        "title": "SoftPlay: Open Panel",
        "icon": "$(inspect)"
      },
      {
        "command": "objectSpy.start",
        "title": "SoftPlay: Start Browser"
      },
      {
        "command": "objectSpy.stop",
        "title": "SoftPlay: Stop Browser"
      },
      {
        "command": "objectSpy.openSettings",
        "title": "SoftPlay: Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "objectSpy.checkRagFreshness",
        "title": "SoftPlay: Check RAG Source Freshness"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node scripts/run-tests.js",
    "rag:benchmark": "tsc -p tsconfig.test.json && node out-test/src/rag/benchmark/ragBenchmarkRunner.js",
    "rag:calibrate": "tsc -p tsconfig.test.json && node out-test/src/rag/benchmark/ragCalibrationRunner.js",
    "rag:evaluate-hybrid": "tsc -p tsconfig.test.json && node out-test/src/rag/benchmark/ragHybridEvaluationRunner.js",
    "pretest-integration": "npm run compile && tsc -p tsconfig.test-integration.json",
    "test-integration": "node out-test-integration/test-integration/runTest.js",
    "package": "node node_modules/@vscode/vsce/vsce package"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^2.32.0",
    "glob": "^13.0.6",
    "mocha": "^12.0.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "exceljs": "^4.4.0",
    "js-yaml": "^4.3.2",
    "mammoth": "^1.12.2",
    "pdfjs-dist": "^6.3.289",
    "playwright": "^1.47.0",
    "zod": "^3.25.76"
  }
}
